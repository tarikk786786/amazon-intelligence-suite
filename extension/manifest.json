{
  "manifest_version": 3,
  "name": "Amazon Intelligence Pro — Pangolinfo Suite",
  "version": "1.0.0",
  "description": "Amazon Keyword Rank Tracker, Blue-Ocean Niche Finder, Google Trends Velocity & Voice of Customer Review Sentiment Miner.",
  "author": "Tarik Islam (tarikislam.in)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Amazon Intelligence Suite"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "https://mcp.pangolinfo.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*"
      ],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
